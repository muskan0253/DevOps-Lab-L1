pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my-app ./Project-1-Dockerizing-Jenkins-Pipeline'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run --rm my-app'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
